.claude/settings.local.json
.claude/scheduled_tasks.lock

# Python-generated files (apkmirror_fetch tooling)
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# apksign debug-key cache used by fetch-prebuilt-apks.py
.cache/

# Headless-browser fallback artifacts (selenium / chromedriver / geckodriver)
*.log
.browser-profile/
.venv/
venv/

# Generated binary distribution bundle (build-and-package-prebuilts.sh output).
# Binaries are not committed; regenerate from source.
dist/

# Generated audit report (enumerate-proxy-bad-symbols.py output). The
# enumerator's exit code is the gate; the report is a local proof artifact,
# regenerated on every run — not committed.
docs/proxy-bad-symbol-audit.md

# Benchmark measurement data (run-benchmarks.sh output). Raw NDJSON runs are
# machine-specific point-in-time measurements, regenerated on demand — not
# committed.
out/
